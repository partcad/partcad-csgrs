#VRML V2.0 utf8
# A 2 x 1 x 0.5 box in tenths of an inch, as KiCad writes a component's model.
Transform {
  children [
    Shape {
      geometry IndexedFaceSet {
        coord Coordinate { point [ 0 0 0, 2 0 0, 2 1 0, 0 1 0, 0 0 0.5, 2 0 0.5, 2 1 0.5, 0 1 0.5 ] }
        coordIndex [ 0 3 2 1 -1, 4 5 6 7 -1, 0 1 5 4 -1, 1 2 6 5 -1, 2 3 7 6 -1, 3 0 4 7 -1 ]
      }
    }
  ]
}
